<!DOCTYPE html>
<html>
<head>
    <title>To Do List</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>My To Do List</h1>

    <form action="/createdata" method="POST">
        <input type="text" name="taskname">
        <button type="submit">Add</button>
    </form>

    <ul>
        <% alltask.forEach(t => { %>
            <li><%= t.taskname %></li>
        <% }) %>
    </ul>

</body>
</html>