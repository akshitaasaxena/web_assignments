<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Mobile</title>
    
</head>

<body>

    <h1>Add Mobile</h1>

    <form action="/addmobile" method="POST">

        <input type="text" name="name" placeholder="Enter Mobile Name">

        <br><br>

        <input type="text" name="model" placeholder="Enter Model">

        <br><br>

        <input type="text" name="ram" placeholder="Enter RAM">

        <br><br>

        <input type="text" name="storage" placeholder="Enter Storage">

        <br><br>

        <input type="number" name="price" placeholder="Enter Price">

        <br><br>
         <input type="text" name="brand" placeholder="Enter Brand">
         <br><br>

        <button type="submit">Add Mobile</button>

    </form>

    <br><br>

</body>

</html>